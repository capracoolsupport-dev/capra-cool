VITE_SUPABASE_URL=https://qhaheskahldwcvggrvbu.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_publishable_key
# Optional. Digits only, including country code. If omitted, email support is used.
VITE_WHATSAPP_NUMBER=

# Server-side order API (configure these in deployment settings; never expose service keys with VITE_).
SUPABASE_URL=https://qhaheskahldwcvggrvbu.supabase.co
SUPABASE_ANON_KEY=your_server_usable_supabase_key
# Optional alternative, server-only: SUPABASE_SERVICE_ROLE_KEY
# Required by the custom clothing studio. Use a Supabase server secret/service-role key.
SUPABASE_SERVICE_ROLE_KEY=
# Optional stable cookie-signing secret (server-only, at least 32 random characters).
# If omitted, the service-role key signs guest design sessions.
CUSTOM_DESIGN_SECRET=
# Optional JSON override for custom studio pricing (integer paise). Defaults to owner-approved ₹100/area.
# CUSTOM_STUDIO_RATES={"version":1,"confirmed":true,"printAreaCents":10000,"embroideryAreaCents":10000,"extraElementCents":0,"colours":{},"sizes":{},"fits":{}}
ADMIN_DASHBOARD_TOKEN=choose_a_private_dashboard_token
